// Pathforge database schema
// PostgreSQL + Prisma. Extends the learning content model with the
// gamification data model described in the Pathforge design (sections 1-19).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core domain models
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  ADMIN
}

enum Difficulty {
  INTRODUCTORY
  FOUNDATIONAL
  INTERMEDIATE
  ADVANCED
  MASTERY
}

enum QuestType {
  DAILY
  WEEKLY
  ROADMAP
  PERSONALIZED
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  DISMISSED
  EXPIRED
}

enum ChallengeResult {
  PASS
  FAIL
  PARTIAL
}

enum MasteryTier {
  DISCOVERED
  UNDERSTOOD
  PRACTICED
  DEMONSTRATED
  MASTERED
}

enum EvidenceType {
  LESSON_COMPLETION
  COMPREHENSION_CHECK
  TOPIC_ASSESSMENT
  PRACTICE_EXERCISE
  REVIEW_SESSION
  PROJECT_MILESTONE
  BOSS_ASSESSMENT
  CHALLENGE_COMPLETION
}

enum CosmeticType {
  AVATAR_ACCESSORY
  MAP_THEME
  PROFILE_DECORATION
  ACHIEVEMENT_STYLE
}

enum ActivityType {
  LESSON
  ASSESSMENT
  PRACTICE
  REVIEW
  PROJECT
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  name        String
  passwordHash String
  avatarUrl   String?
  bio         String?
  role        Role     @default(LEARNER)
  timezone    String   @default("UTC")
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gameProfile      UserGameProfile?
  settings         UserSettings?
  xpTransactions   XPTransaction[]
  achievements     UserAchievement[]
  quests           UserQuest[]
  streakRecords    UserStreakRecord[]
  cosmeticInventory UserCosmeticInventory[]
  assessmentAttempts AssessmentAttempt[]
  challengeAttempts ChallengeAttempt[]
  lessonCompletions LessonCompletion[]
  skillProgress    UserSkillProgress[]
  masterEvidence   UserMasteryEvidence[]
  milestoneCompletions ProjectMilestoneCompletion[]
  roadmapEnrollments RoadmapEnrollment[]
  sessions         Session[]

  @@index([username])
  @@index([email])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                String   @default("system") // light | dark | system
  language             String   @default("en")
  notificationsEnabled Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  streakNotifications  Boolean  @default(true)
  hideStreakDisplay    Boolean  @default(false)
  reducedMotion        Boolean  @default(false)
  aiCompanionEnabled   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Learning content (roadmaps, topics/skill nodes, lessons, assessments,
// projects)
// ---------------------------------------------------------------------------

model LearningDomain {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  color       String   @default("signal")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  roadmaps Roadmap[]

  @@index([order])
  @@index([slug])
}

model Roadmap {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  domainId    String
  role        String?  // role-based roadmap (kingdom/territory), e.g. "Frontend Engineer"
  difficulty  Difficulty @default(FOUNDATIONAL)
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  xpMilestoneReward Int  @default(200) // completing the whole roadmap
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      LearningDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skillNodes  SkillNode[]
  enrollments RoadmapEnrollment[]
  quests      QuestDefinition[]
  challenges  Challenge[]
  projects    Project[]
  assessments Assessment[]

  @@index([domainId])
  @@index([slug])
  @@index([order])
}

model RoadmapEnrollment {
  id          String   @id @default(cuid())
  userId      String
  roadmapId   String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  progress    Int      @default(0) // 0-100

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
  @@index([roadmapId])
}

model SkillNode {
  id            String   @id @default(cuid())
  slug          String
  roadmapId     String
  title         String
  explanation   String?  @db.Text
  difficulty    Difficulty @default(FOUNDATIONAL)
  order         Int      @default(0)
  // Node states are computed per-user in UserSkillProgress. This flag marks
  // whether the node itself is visible/published in the content system.
  isPublished   Boolean  @default(true)
  xpReward      Int      @default(10) // completing the lesson/check at this node
  createdAt     DateTime @default(now())

  roadmap       Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  assessments   Assessment[]
  projects      Project[]
  progress      UserSkillProgress[]
  masterEvidence UserMasteryEvidence[]

  // Prerequisite skill nodes (self-relation). A node is "available" when its
  // prerequisites are mastered (or the configured tier is reached).
  prerequisites          SkillNodePrerequisite[]
  prerequisiteOf         SkillNodePrerequisite[] @relation("PrerequisiteOf")

  @@index([roadmapId])
  @@index([roadmapId, slug])
  @@index([order])
}

model SkillNodePrerequisite {
  id             String @id @default(cuid())
  skillNodeId    String
  prerequisiteId String
  requiredTier   MasteryTier @default(DEMONSTRATED)

  skillNode      SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)
  prerequisite   SkillNode @relation("PrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([skillNodeId, prerequisiteId])
  @@index([prerequisiteId])
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String
  skillNodeId   String
  title         String
  body          String   @db.Text // lesson content (markdown)
  comprehensionCheck Boolean @default(true)
  xpReward      Int      @default(10)
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  skillNode     SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)
  completions   LessonCompletion[]

  @@index([skillNodeId])
  @@index([slug])
}

model LessonCompletion {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completedAt DateTime @default(now())
  xpAwarded Int      @default(0)

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Assessment {
  id          String   @id @default(cuid())
  slug        String
  skillNodeId String?
  roadmapId   String? // boss assessments span a whole roadmap
  title       String
  description String?  @db.Text
  passingScore Int     @default(80) // percent
  xpReward    Int      @default(15)
  isBoss      Boolean  @default(false)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  skillNode  SkillNode?   @relation(fields: [skillNodeId], references: [id], onDelete: SetNull)
  roadmap    Roadmap?   @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  questions  AssessmentQuestion[]
  attempts   AssessmentAttempt[]

  @@index([skillNodeId])
  @@index([roadmapId])
  @@index([isBoss])
}

model AssessmentQuestion {
  id           String   @id @default(cuid())
  assessmentId String
  type         String   // multiple_choice | short_answer | code
  prompt       String   @db.Text
  options      Json?    // for multiple_choice
  correctAnswer String  @db.Text
  explanation  String?  @db.Text
  order        Int      @default(0)
  points       Int      @default(1)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model AssessmentAttempt {
  id          String   @id @default(cuid())
  userId      String
  assessmentId String
  score       Int      // percent correct
  passed      Boolean
  answers     Json?    // raw submitted answers
  feedback    String?  @db.Text
  attemptedAt DateTime @default(now())
  completedAt DateTime?

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
}

// ---------------------------------------------------------------------------
// Projects & milestones
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  roadmapId   String?
  skillNodeId String?
  xpReward    Int      @default(30) // per completed milestone
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  roadmap    Roadmap?   @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  skillNode  SkillNode? @relation(fields: [skillNodeId], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]

  @@index([roadmapId])
  @@index([skillNodeId])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  xpReward    Int      @default(30)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completions ProjectMilestoneCompletion[]

  @@index([projectId])
  @@index([order])
}

model ProjectMilestoneCompletion {
  id          String   @id @default(cuid())
  userId      String
  milestoneId String
  evidenceUrl String?  @db.Text // portfolio evidence
  submittedAt DateTime @default(now())
  reviewed    Boolean  @default(false)
  approved    Boolean  @default(false)
  xpAwarded   Int      @default(0)

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
  @@index([userId])
  @@index([milestoneId])
}

// ---------------------------------------------------------------------------
// Gamification data model (section 16)
// ---------------------------------------------------------------------------

model UserGameProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  level                  Int      @default(1)
  totalXP                Int      @default(0)
  currentStreak          Int      @default(0)
  longestStreak          Int      @default(0)
  lastQualifyingActivityAt DateTime?
  timezone               String   @default("UTC")
  hideStreakDisplay      Boolean  @default(false)
  streakNotifications    Boolean  @default(true)
  aiCompanionEnabled     Boolean  @default(true)
  selectedCosmetics      Json?    // equipped cosmetic item ids
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  eventId     String   @unique // idempotency key
  eventType   String   // lesson_complete | assessment_pass | challenge_pass | milestone_complete | quest_complete | ...
  amount      Int
  reason      String
  topicId     String?
  assessmentId String?
  challengeId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  category    String   // exploration | learning | practice | mastery | consistency | projects
  unlockCriteria Json   // machine-checkable criteria
  rewardXp    Int      @default(0)
  badgeIcon   String   @default("badge")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@index([slug])
  @@index([category])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementId  String
  unlockedAt     DateTime @default(now())
  evidenceReference String? // link to the assessment/challenge/milestone that triggered it

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([unlockedAt])
}

model QuestDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  questType   QuestType
  objectives  Json     // list of { kind, target, conceptId }
  prerequisites Json?  // roadmapId, minLevel, completedQuestSlugs
  rewardXp    Int      @default(10)
  availabilityRules Json? // time-of-day, day-of-week, active window
  isActive    Boolean  @default(true)
  expiresAt   DateTime? // for daily/weekly/seasonal quests
  createdAt   DateTime @default(now())

  userQuests UserQuest[]

  // Optional: roadmap quests belong to a roadmap; daily/weekly quests do not.
  roadmapId   String?
  roadmap     Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([questType])
  @@index([isActive])
  @@index([roadmapId])
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  status      QuestStatus @default(ACTIVE)
  progressData Json    // { objectiveKey: currentValue }
  startedAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([status])
  @@index([userId, status])
}

model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  story       String?  @db.Text // dungeon/boss narrative objective
  difficulty  Difficulty @default(INTERMEDIATE)
  relatedConcepts Json   // skill node slugs
  completionCriteria Json // what counts as passing
  xpReward    Int      @default(20)
  isBoss      Boolean  @default(false)
  relatedAssessmentId String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  attempts  ChallengeAttempt[]

  roadmapId String

  @@index([roadmapId])
  @@index([slug])
  @@index([isBoss])
}

model ChallengeAttempt {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  submittedWorkReference String? // portfolio/code link
  result      ChallengeResult
  feedback    String?  @db.Text
  score       Int?
  attemptedAt DateTime @default(now())
  completedAt DateTime?
  xpAwarded   Int      @default(0)

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@index([userId, challengeId])
}

model UserMasteryEvidence {
  id             String   @id @default(cuid())
  userId         String
  conceptId      String   // skill node id
  evidenceType   EvidenceType
  evidenceReference String? // assessment/challenge/milestone id
  result         String   // PASS | FAIL | PARTIAL
  tier           MasteryTier
  recordedAt     DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillNode SkillNode @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conceptId])
  @@index([userId, conceptId])
  @@index([tier])
}

model UserStreakRecord {
  id        String   @id @default(cuid())
  userId    String
  localDate String   // YYYY-MM-DD in user timezone
  qualifyingActivityType ActivityType
  timezone  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId])
  @@index([localDate])
}

model UserSkillProgress {
  id           String   @id @default(cuid())
  userId       String
  skillNodeId  String
  status       String   // unknown | discovered | available | in_progress | practiced | demonstrated | mastered | review_due
  tier         MasteryTier @default(DISCOVERED)
  xpEarned     Int      @default(0)
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillNode SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, skillNodeId])
  @@index([userId])
  @@index([skillNodeId])
  @@index([status])
}

model CosmeticItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?  @db.Text
  cosmeticType CosmeticType
  unlockCriteria Json   // e.g. { achievementSlug: "first-mastery" }
  sparkCost    Int      @default(0)
  imageUrl     String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())

  inventory UserCosmeticInventory[]

  @@index([slug])
  @@index([cosmeticType])
}

model UserCosmeticInventory {
  id           String   @id @default(cuid())
  userId       String
  cosmeticItemId String
  unlockedAt   DateTime @default(now())
  equippedAt   DateTime?

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item CosmeticItem @relation(fields: [cosmeticItemId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticItemId])
  @@index([userId])
}

model SeasonalEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime
  eventConfiguration Json // activities, milestones, rewards
  completionRewardXp Int @default(50)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([slug])
  @@index([startsAt, endsAt])
}
