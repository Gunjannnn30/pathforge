# ---------------------------------------------------------------------------
# Pathforge environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL (local embedded dev DB defaults shown)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathforge?schema=public"

# Optional: test database used by integration tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathforge_test?schema=public"

# Session
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# AI (optional). Pathforge works without AI; the study companion degrades to
# static guidance when no provider is configured.
# AI_PROVIDER: ollama | gemini | openai | none
# ---------------------------------------------------------------------------
AI_PROVIDER="none"
AI_TIMEOUT_MS="60000"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Local embedded PostgreSQL control (scripts/db.mjs)
# ---------------------------------------------------------------------------
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="postgres"
PG_DATABASE="pathforge"
PG_TEST_DATABASE="pathforge_test"
PG_DATA_DIR=".pgdata"
